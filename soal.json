<!DOCTYPE html>        
<html>        
<head>        
<meta charset="UTF-8">        
<title>Belajar HSK App</title>        
      
<style>
body {
    visibility: hidden;
}

body.ready {
    visibility: visible;
}
body{      
    margin:0;      
    padding:0;      
    font-family:Times New Roman;      
    text-align:center;      
    font-size:50px;      
    color:#222;      
    background:#F8F4E9;      
    transition: background 0.5s, color 0.5s;      
}      
      
body.dark-mode{      
    background:#1e1e1e;      
    color:#f2f2f2;      
}      
      
h1{ margin-bottom:5px; }      
      
#subtitle{      
    font-size:20px;      
    color:gray;      
    margin-top:-5px;      
    margin-bottom:20px;      
}      
      
#game{      
    opacity:1;      
    transition: opacity 0.5s ease;      
}      
      
#progressContainer{      
    width:90%;      
    height:22px;      
    background:#ddd;      
    border-radius:999px;      
    margin:20px auto;      
    overflow:hidden;      
}      
      
body.dark-mode #progressContainer{      
    background:#333;      
}      
      
#progressBar{      
    height:100%;      
    width:0%;      
    background:#FFA500;      
    border-radius:999px;      
    transition: width 0.5s ease;      
}      
      
button{      
    font-family:Monospace;      
    width:90%;      
    padding:40px;      
    margin:5px;      
    font-size:40px;      
    transition: background 0.3s ease;      
}      
      
body.dark-mode button{      
    background:#2b2b2b;      
    color:#f2f2f2;      
}      
      
#clock{      
    font-size:18px;      
    color:gray;      
    margin-bottom:10px;      
}      
      
h3{      
    font-family: Times New Roman;      
    font-size: 35px;      
    color: gray;      
}      
      
#result{      
    transition: opacity 0.3s ease;      
}      
      
.hanzi{      
    font-family:Sans-Serif;      
    font-size:200px;      
}      
      
.pinyin{      
    font-size:40px;      
    color:gray;      
}      
      
body.dark-mode .pinyin{      
    color:#aaa;      
}      
      
#bottomArea{      
    position: fixed;      
    bottom: 40px;      
    left: 50%;      
    transform: translateX(-50%);      
}      
      
#modeToggle{      
    width:100px;      
    height:100px;      
    border:none;      
    background:transparent;      
    cursor:pointer;      
    color:#444;      
      
    display:flex;      
    align-items:center;      
    justify-content:center;      
      
    font-size:86px;      
    line-height:1;      
      
    -webkit-tap-highlight-color: transparent;      
    outline: none;      
    user-select: none;      
    transition: none;      
}      
      
body.dark-mode #modeToggle{      
    color:#ddd;      
}      
      
#credit{      
    position: fixed;      
    bottom: 10px;      
    left: 0;      
    right: 0;      
    display:flex;      
    justify-content:center;      
    font-size:14px;      
    color:gray;      
}      
      
body.dark-mode #credit{      
    color:#aaa;      
}      
/*
